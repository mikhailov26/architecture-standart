@startuml
!include <C4/C4_Context>
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title System Context — Rates → Contact Centre

Person(backoffice, "Бэк-офис", "Загружает XLS со ставками")
System(kc_partner, "Партнёрский КЦ (внешний)", "Получает ставки по защищённой почте")

System(rates, "Сервис ставок (Rates)", "Управляет публикацией и хранением ставок")
System(kc_internal, "Контакт-центр (внутренний)", "Использует текущие ставки для работы")

System(exporter, "Rates Exporter", "Экспортирует ставки в CSV/JSON")
System(mail_gateway, "Почтовый шлюз", "Отправляет защищённые письма")

Rel(backoffice, rates, "XLS загрузка/публикация", "HTTP/API")
Rel(rates, kc_internal, "API/DB view текущих ставок", "REST/SQL")
Rel(rates, exporter, "событие публикации", "Message")

Rel(exporter, mail_gateway, "CSV/JSON", "HTTP/SFTP")
Rel(mail_gateway, kc_partner, "защищённая почта (PGP/SMIME)", "SMTP")
@enduml